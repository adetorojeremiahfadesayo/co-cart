# Server-side only. Never prefix this key with VITE_.
OPENAI_API_KEY=sk-your-key-here
COCART_MCP_API_KEY=sk-your-key-here

# Optional. Defaults to gpt-5.6.
OPENAI_MODEL=gpt-5.6

# Optional. Defaults to the current Realtime voice model.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Optional server-side abuse controls.
COCART_SEARCH_RATE_LIMIT=5
COCART_MAX_CONCURRENT_SEARCHES=8
COCART_REALTIME_RATE_LIMIT=3
